---
import AiSection from '../components/AiSection.astro';
import Hero from '../components/Hero.astro';
import ImpactStrip from '../components/ImpactStrip.astro';
import OpenSource from '../components/OpenSource.astro';
import Stack from '../components/Stack.astro';
import WorkCards from '../components/WorkCards.astro';
import Base from '../layouts/Base.astro';
import { loadSiteData } from '../lib/data.ts';

const data = loadSiteData();
---
<Base
  title="Aleksandr Letunov — DevSecOps & Platform Engineering Tech Lead"
  description="Aleksandr Letunov, DevSecOps and platform engineering tech lead: IaC platforms, Kubernetes and Claude Code agents for infrastructure work."
  path="/"
  current="about"
>
  <Hero profile={data.profile} />
  <ImpactStrip metrics={data.metrics} />
  <WorkCards entries={data.work} />
  <AiSection />
  <OpenSource github={data.profile.links.github} />
  <Stack stack={data.stack} />
</Base>
