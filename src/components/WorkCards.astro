---
import AppIcon from './AppIcon.astro';

export interface WorkCard {
  id: string;
  title: string;
  oneLiner: string;
  kind: string;
}

const { entries } = Astro.props as { entries: WorkCard[] };
---
<section id="work" class="section">
  <h2 class="section-title"><span class="tag" style="--tag: var(--purple)"></span>Selected work</h2>
  <ul class="cards">
    {
      entries.map((e) => (
        <li class="card surface">
          <AppIcon kind={e.kind} />
          <div>
            <h3>
              <a href={`/work/${e.id}/`}>{e.title}</a>
            </h3>
            <p>{e.oneLiner}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .card {
    position: relative;
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.95rem 1rem;
    min-width: 0;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card > div {
    min-width: 0;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }
  h3 {
    font-size: 1rem;
    margin: 0.1rem 0 0.3rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }
  @media (max-width: 719px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
