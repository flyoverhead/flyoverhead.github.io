---
import AppIcon from './AppIcon.astro';
import type { Work } from '../lib/schema.ts';

const { entries } = Astro.props as { entries: Work[] };
---
<section id="work" class="section">
  <h2 class="section-title"><span class="tag" style="--tag: var(--purple)"></span>Selected work</h2>
  <ul class="cards">
    {
      entries.map((e) => (
        <li class="card surface">
          <AppIcon kind={e.kind} />
          <div>
            <h3>{e.title}</h3>
            <p>{e.oneLiner}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .card {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.95rem 1rem;
    min-width: 0;
  }
  .card > div {
    min-width: 0;
  }
  h3 {
    font-size: 1rem;
    margin: 0.1rem 0 0.3rem;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }
  @media (max-width: 719px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
