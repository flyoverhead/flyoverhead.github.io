---
import type { RepoInfo } from '../lib/github.ts';

const { repos, github } = Astro.props as { repos: RepoInfo[]; github: string };
---
<section id="oss" class="section">
  <h2 class="section-title"><span class="tag" style="--tag: var(--green)"></span>Open source</h2>
  <ul class="list">
    {
      repos.map((r) => (
        <li class="repo surface">
          <div>
            <a class="name mono" href={r.url}>{r.label ?? r.name}</a>
            <p>{r.description}</p>
          </div>
          <span class="meta">
            {r.language && <span>{r.language}</span>}
            {r.stars > 0 && <span>★ {r.stars}</span>}
          </span>
        </li>
      ))
    }
  </ul>
  <p><a href={github}>More on GitHub →</a></p>
</section>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
  }
  .repo {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.4rem;
    padding: 0.75rem 0.9rem;
    min-width: 0;
  }
  .name {
    color: var(--heading);
    font-size: 0.88rem;
    font-weight: 600;
  }
  p {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .meta {
    display: flex;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.78rem;
  }
  @media (max-width: 719px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
