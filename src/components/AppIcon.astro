---
const ICONS: Record<string, { glyph: string; from: string; to: string }> = {
  platform: { glyph: '⬢', from: '#5ac8fa', to: '#007aff' },
  ai: { glyph: '✦', from: '#da8fff', to: '#8e44ff' },
  kubernetes: { glyph: '☸', from: '#ffb340', to: '#ff6b00' },
  migration: { glyph: '⇄', from: '#7ef29d', to: '#22b14c' },
  go: { glyph: '◆', from: '#8be9fd', to: '#30b0c7' },
  reliability: { glyph: '◉', from: '#ff8aa8', to: '#ff2d55' },
  security: { glyph: '◈', from: '#a5a3ff', to: '#5e5ce6' },
};
const { kind, size = 2.6 } = Astro.props as { kind: string; size?: number };
const icon = ICONS[kind] ?? ICONS.platform;
---
<span
  class="app-icon"
  aria-hidden="true"
  style={`--from: ${icon.from}; --to: ${icon.to}; --size: ${size}rem`}>{icon.glyph}</span
>

<style>
  .app-icon {
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    flex: 0 0 var(--size);
    border-radius: 22%;
    background: linear-gradient(135deg, var(--from), var(--to));
    color: #ffffff;
    font-size: calc(var(--size) * 0.45);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      0 2px 6px rgba(0, 0, 0, 0.18);
  }
</style>
