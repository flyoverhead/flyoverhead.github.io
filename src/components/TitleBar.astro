---
import ThemeToggle from './ThemeToggle.astro';
import { SECTIONS, type SectionKey } from './sections.ts';

const { current } = Astro.props as { current?: SectionKey };
const segments = [
  { href: '/', label: 'Overview', active: current === 'about' },
  { href: '/#work', label: 'Work', active: current === 'work' },
  { href: '/cv/', label: 'CV', active: current === 'cv' },
];
---
<header class="top">
  <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
  <nav class="segmented" aria-label="Main">
    {segments.map((s) => <a href={s.href} aria-current={s.active ? 'page' : undefined}>{s.label}</a>)}
  </nav>
  <div class="right">
    <details class="menu">
      <summary>Menu</summary>
      <ul>
        {SECTIONS.map((s) => <li><a href={s.href}><span class="tag" style={`--tag: var(--${s.color})`}></span>{s.label}</a></li>)}
      </ul>
    </details>
    <ThemeToggle />
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.4rem 1rem;
    background: var(--titlebar);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--sep);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .lights {
    display: flex;
    gap: 0.5rem;
  }
  .lights i {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    display: block;
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }
  .segmented {
    display: flex;
    padding: 2px;
    border-radius: 8px;
    background: var(--sep);
    font-size: 0.82rem;
  }
  .segmented a {
    padding: 0.2rem 0.9rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--text);
  }
  .segmented a[aria-current='page'] {
    background: var(--surface);
    box-shadow: var(--surface-shadow);
  }
  .right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.4rem;
  }
  .menu {
    position: relative;
    display: none;
  }
  .menu summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.82rem;
    padding: 0.2rem 0.7rem;
    border-radius: 6px;
    background: var(--sep);
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    min-width: 12rem;
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    border-radius: var(--radius);
    background: var(--titlebar);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--sep);
    box-shadow: var(--window-shadow);
  }
  .menu a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.7rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .menu a:hover {
    background: var(--selected-bg);
  }
  @media (max-width: 899px) {
    .menu {
      display: block;
    }
  }
  @media (max-width: 559px) {
    .top {
      grid-template-columns: auto 1fr;
    }
    .segmented {
      display: none;
    }
  }
</style>
