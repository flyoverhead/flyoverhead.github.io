---
const { nodes } = Astro.props as { nodes: string[] };
---
<figure class="diagram" aria-label={`Flow: ${nodes.join(' to ')}`}>
  <ol>
    {nodes.map((n) => <li class="node mono">{n}</li>)}
  </ol>
  <figcaption class="muted">Redrawn, simplified flow</figcaption>
</figure>

<style>
  .diagram {
    margin: 1.25rem 0;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.6rem;
  }
  .node {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    box-shadow: var(--surface-shadow);
    border-radius: 8px;
    padding: 0.45rem 0.75rem;
    font-size: 0.78rem;
    color: var(--heading);
  }
  .node + .node::before {
    content: '→';
    position: absolute;
    left: -1.2rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--purple);
  }
  figcaption {
    font-size: 0.75rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 539px) {
    ol {
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
    }
    .node + .node::before {
      content: '↓';
      left: 50%;
      top: -1.4rem;
      transform: translateX(-50%);
    }
  }
</style>
