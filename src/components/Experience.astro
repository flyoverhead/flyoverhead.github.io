---
import type { Experience } from '../lib/schema.ts';

const { experience } = Astro.props as { experience: Experience };
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (ym: string | null) => (ym ? `${MONTHS[Number(ym.slice(5, 7)) - 1]} ${ym.slice(0, 4)}` : 'now');
---
<section id="experience" class="section">
  <h2 class="section-title"><span class="tag" style="--tag: var(--pink)"></span>Experience</h2>
  <ol class="tl">
    {
      experience.roles.map((r) => (
        <li class="role">
          <h3>
            {r.title} <span class="muted">· {r.employer}</span>
          </h3>
          <p class="when">
            {fmt(r.start)} – {fmt(r.end)}
            {r.team && <> · team of {r.team}</>}
          </p>
          <p>{r.summary}</p>
        </li>
      ))
    }
    <li class="old">
      <h3>Before infrastructure</h3>
      <p class="when">{experience.beforeInfra.period}</p>
      <p>{experience.beforeInfra.text}</p>
    </li>
  </ol>
  <p class="edu muted">
    {experience.education.school} · {experience.education.degree} · {experience.education.period}
  </p>
</section>

<style>
  .tl {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
    border-left: 2px solid var(--sep);
  }
  li {
    position: relative;
    margin-bottom: 1.25rem;
  }
  li::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 7px);
    top: 0.3rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 0 3px var(--wall-base);
  }
  li.old::before {
    background: var(--muted);
  }
  h3 {
    font-size: 1rem;
    margin: 0;
  }
  .when {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0.1rem 0 0.3rem;
  }
  li p:last-child {
    margin: 0;
    font-size: 0.93rem;
  }
  .edu {
    font-size: 0.85rem;
  }
</style>
