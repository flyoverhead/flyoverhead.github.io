<button class="theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M10 2.5a7.5 7.5 0 0 1 0 15z" fill="currentColor"></path></svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .theme-toggle {
    display: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 7px;
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  :global(.js) .theme-toggle {
    display: grid;
  }
  .theme-toggle:hover {
    background: var(--sep);
  }
</style>
