---
import type { Metric } from '../lib/schema.ts';

const { metrics } = Astro.props as { metrics: Metric[] };
const COLORS = ['blue', 'purple', 'orange', 'green'];
---
<section id="impact" aria-label="Impact">
  <ul class="grid">
    {
      metrics.map((m, i) => (
        <li class="surface">
          <b style={`color: var(--${COLORS[i % COLORS.length]})`}>{m.value}</b>
          <span>{m.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  #impact {
    padding-top: 1.75rem;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  li {
    padding: 0.9rem 1rem;
    min-width: 0;
  }
  b {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  span {
    color: var(--muted);
    font-size: 0.8rem;
  }
  @media (max-width: 719px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
