{
  "name": "flyoverhead-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/render.ts",
    "preview": "astro preview --port 4329 --ignore-lock",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "html-validate \"dist/**/*.html\"",
    "render": "node scripts/render.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "html-validate": "11.16.2",
    "vitest": "5.0.3"
  }
}
